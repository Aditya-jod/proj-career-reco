# Backend Environment Variables
# Copy this file to .env and fill in your own values.
# DO NOT commit .env to version control.

# ── MongoDB ──────────────────────────────────────────────────────
# Local MongoDB URI. Change host/port to match your setup.
MONGODB_URI=mongodb://localhost:44551/
MONGODB_DB_NAME=career_recommender

# ── JWT ──────────────────────────────────────────────────────────
# Generate a strong random secret, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<generate-a-random-secret-and-put-here>
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=48

# ── API ──────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Environment ──────────────────────────────────────────────────
APP_ENV=development

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
