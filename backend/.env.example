# Backend Environment Variables
# Copy this file to .env and fill in your own values.
# DO NOT commit .env to version control.

# ── MongoDB ──────────────────────────────────────────────────────
# MongoDB connection URI (e.g., mongodb://<host>:<port>/)
MONGODB_URI=<your-mongodb-uri>
# MongoDB database name
MONGODB_DB_NAME=<your-database-name>

# ── JWT ──────────────────────────────────────────────────────────
# JWT secret key (generate a strong random value)
JWT_SECRET_KEY=<your-jwt-secret-key>
# JWT algorithm (e.g., HS256)
JWT_ALGORITHM=<your-jwt-algorithm>
# JWT expiration in hours (e.g., 48)
JWT_EXPIRE_HOURS=<jwt-expire-hours>

# ── API ──────────────────────────────────────────────────────────
# API host (e.g., 0.0.0.0)
API_HOST=<api-host>
# API port (e.g., 8000)
API_PORT=<api-port>

# ── Environment ──────────────────────────────────────────────────
# Application environment (e.g., development, production)
APP_ENV=<app-environment>

# ── Logging ──────────────────────────────────────────────────────
# Logging level (e.g., INFO, DEBUG)
LOG_LEVEL=<log-level>
