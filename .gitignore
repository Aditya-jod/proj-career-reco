models/*.pkl
models/*.npy
models/*.joblib
models/*.h5
models/*.pth
models/cache/

# backend sub-folder duplicates (kept in sync)
backend/models/*.pkl
backend/models/*.npy
backend/models/*.joblib
backend/models/cache/

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# ── Environments & Secrets ───────────────────────────────────────
# Never commit real .env files
.env
.env.local
.env.*.local
**/.env
backend/.env
frontend/.env

# Config files that contain local paths or secrets
backend/config/config.yaml

# Virtual environments
venv/
env/
.venv/
backend/venv/
frontend/node_modules/

# Auth / keys
*.pem
*.key
*.cert
*.p12
secrets/

# ── Notebooks ────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Logs ─────────────────────────────────────────────────────────
*.log
logs/

# ── Database ─────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
backend/data/MongoDB/mongodb.py

# ── OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ──────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Frontend build ───────────────────────────────────────────────
frontend/dist/
frontend/node_modules/frontend/tsconfig.*.tsbuildinfo
*.tsbuildinfo
bun.lock

